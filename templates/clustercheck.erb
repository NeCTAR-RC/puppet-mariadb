#!/bin/bash
# put this file to /usr/local/bin
#
# This script checks if a mysql server is healthy running on localhost. It will
# return:
#
# "HTTP/1.x 200 OK\r" (if mysql is running smoothly)
#
# - OR -
#
# "HTTP/1.x 500 Internal Server Error\r" (else)
#
# The purpose of this script is make haproxy capable of monitoring mysql properly
#
# Author: Unai Rodriguez
#
# It is recommended that a user with limited privileges is created to be used by
# this script. Something like this:
#
# mysql> GRANT PROCESS on mysql.* TO 'clustercheckuser'@'localhost' \
#     -> IDENTIFIED BY 'clustercheckpassword!' WITH GRANT OPTION;
# mysql> flush privileges;

MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USERNAME=<%= @status_user %>
MYSQL_PASSWORD=<%= @real_status_password %>
TMP_FILE="/tmp/clustercheck.out"
ERR_FILE="/tmp/clustercheck.err"

#
# Read the HTTP request before replying. If the script exits with the request
# unread, the kernel resets the connection and discards any output still
# queued. haproxy delays its ACK on check connections, so only the first
# write ever reaches it before that reset; with the uutils echo on Ubuntu
# 26.04 the first write is the bare status line, and the check fails.
# Consuming the request turns the exit into a normal close, which delivers
# everything queued before the connection ends.
#
while read -r -t 1 line; do
    [ -z "${line%$'\r'}" ] && break
done

#
# Send a well-formed HTTP reply. Content-Length lets the client finish reading
# without waiting for the connection to close. bash's stdout is line
# buffered, so this may still go out as several writes; that is fine now
# that the connection closes normally.
#
reply() {
    local body="$2"$'\r\n'
    printf 'HTTP/1.1 %s\r\nContent-Type: text/plain\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s' \
        "$1" "${#body}" "$body"
}

#
# We perform a simple query that should return a few results :-p
#

WSSREP_STATUS=`mariadb --host=$MYSQL_HOST --user=$MYSQL_USERNAME --password=$MYSQL_PASSWORD -e "show status like 'wsrep_local_state';" | awk '{if (NR!=1){print $2}}' 2>/dev/null`
GCOMM_ADDRESS=`mariadb --host=$MYSQL_HOST --user=$MYSQL_USERNAME --password=$MYSQL_PASSWORD -e "show variables like 'wsrep_cluster_address';" | awk '{if (NR!=1){print $2}}' 2>/dev/null`

if [ "$WSSREP_STATUS" == "4" ] && [ "$GCOMM_ADDRESS" != 'gcomm://' ]
then
    # mysql is fine, return http 200
    reply "200 OK" "Node is running."
else
    # mysql is not fine, return http 503
    reply "503 Service Unavailable" "Node is *down*."
fi
